# Build on workstation with ORIGINAL task image digest; never replace its testbed.
ARG TASK_IMAGE
FROM ${TASK_IMAGE}
USER root
ARG SDK_PYTHON=/opt/conda/bin/python
ARG CLAUDE_SHA256
# Require a separate >=3.11 interpreter provisioned at build time. Fail, do not upgrade testbed.
RUN ${SDK_PYTHON} -c 'import sys; assert sys.version_info >= (3,11)'
RUN ${SDK_PYTHON} -m venv /opt/self-curate-sdk
COPY docker/requirements-sdk.txt /opt/self-curate-sdk/requirements.txt
RUN /opt/self-curate-sdk/bin/pip install -r /opt/self-curate-sdk/requirements.txt
COPY pyproject.toml README.md /opt/self-curate-source/
COPY src /opt/self-curate-source/src
RUN /opt/self-curate-sdk/bin/pip install --no-deps /opt/self-curate-source
COPY docker/install_claude.py /opt/self-curate-sdk/install_claude.py
RUN CLAUDE_SHA256=${CLAUDE_SHA256} /opt/self-curate-sdk/bin/python /opt/self-curate-sdk/install_claude.py \
    && /opt/self-curate-sdk/bin/pip check \
    && /opt/self-curate-sdk/bin/pip freeze --all > /opt/self-curate-sdk/environment.lock.txt
# Match the workstation-verified task workspace owner; no Docker socket or host HOME mounts.
ARG TASK_UID=1000
ARG TASK_GID=1000
USER ${TASK_UID}:${TASK_GID}
