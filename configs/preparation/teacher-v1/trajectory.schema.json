{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "instance_id",
    "ontology_version",
    "trajectory_id",
    "coverage_state",
    "skills",
    "annotation_risks",
    "missing_context",
    "confidence",
    "annotation_decision",
    "decision_reason"
  ],
  "properties": {
    "schema_version": {
      "const": "teacher-trajectory-v1"
    },
    "request_id": {
      "type": "string"
    },
    "instance_id": {
      "type": "string"
    },
    "ontology_version": {
      "const": "coding-skills-v1"
    },
    "trajectory_id": {
      "type": "string"
    },
    "coverage_state": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "skills": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill_id",
          "status",
          "subtype",
          "reason",
          "events"
        ],
        "properties": {
          "skill_id": {
            "enum": [
              "behavior_state",
              "data_representation",
              "interface_integration",
              "platform_build",
              "resource_concurrency",
              "algorithm_math"
            ]
          },
          "status": {
            "enum": [
              "demonstrated",
              "not_observed",
              "uncertain"
            ]
          },
          "subtype": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event_id",
                "context_refs",
                "assistant_refs",
                "outcome_refs",
                "verification_scope",
                "reason"
              ],
              "properties": {
                "event_id": {
                  "type": "string"
                },
                "context_refs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/evidence_ref"
                  }
                },
                "assistant_refs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/evidence_ref"
                  }
                },
                "outcome_refs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/evidence_ref"
                  }
                },
                "verification_scope": {
                  "enum": [
                    "observed_artifact",
                    "targeted_check",
                    "regression_check",
                    "source_only",
                    "unknown"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "annotation_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "annotation_decision": {
      "enum": [
        "retain",
        "exclude_no_skill",
        "needs_review"
      ]
    },
    "decision_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "message_id",
        "field",
        "quote"
      ],
      "properties": {
        "source": {
          "enum": [
            "task",
            "trajectory",
            "helper_trajectory"
          ]
        },
        "message_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "field": {
          "type": "string"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
