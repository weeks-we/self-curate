{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "data_id",
    "verdict",
    "issues",
    "corrected_annotation",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": "teacher-review-v1"
    },
    "request_id": {
      "type": "string"
    },
    "data_id": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "approve",
        "revise",
        "needs_context",
        "reject_annotation"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "reason",
          "source_refs"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "source_refs": {
            "type": "array"
          }
        }
      }
    },
    "corrected_annotation": {
      "type": [
        "object",
        "null"
      ]
    },
    "reason": {
      "type": "string"
    }
  }
}
