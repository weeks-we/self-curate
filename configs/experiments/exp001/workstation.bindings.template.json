{
  "execution_location": "workstation",
  "backend": "real",
  "output": "/storage/self-curate-rebench/preparation",
  "ontology": "configs/experiments/exp001/ontology.pending.json",
  "download_lock": "/storage/self-curate-rebench/source-lock.json",
  "sources": "/storage/self-curate-rebench/sources",
  "terminal_source": "/storage/self-curate-rebench/terminal-source.json",
  "source_registry": "/storage/self-curate-rebench/source-registry.json",
  "source_lock": "/storage/self-curate-rebench/prepared-source-lock.json",
  "tasks": "/storage/self-curate-rebench/exports/tasks.jsonl",
  "trajectories": "/storage/self-curate-rebench/exports/trajectories.jsonl",
  "trajectory_revision": null,
  "benchmark_instances": "/storage/self-curate-rebench/environments/benchmark-instances.jsonl",
  "candidate_count": null,
  "candidate_count_rule": "min(eligible_tasks,max(1000,200*skill_count)); fixed shuffled prefix",
  "development_per_skill": 50,
  "seed": 42,
  "max_context_tokens": 131072,
  "teacher": {
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-flash",
    "api_key_env": "DEEPSEEK_API_KEY",
    "max_calls": null,
    "max_output_tokens": 16384,
    "timeout_seconds": 900
  },
  "review_teacher": {
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-v4-pro",
    "api_key_env": "DEEPSEEK_API_KEY",
    "max_calls": null,
    "max_output_tokens": 16384,
    "timeout_seconds": 900
  },
  "teacher_cache": "/storage/self-curate-rebench/annotations/primary",
  "review_cache": "/storage/self-curate-rebench/annotations/review",
  "model": "/storage/self-curate-rebench/preparation/model.json",
  "tokenizer_path": "/storage/self-curate-rebench/sources/model/files",
  "lora": {
    "rank": 16,
    "alpha": 32,
    "dropout": 0,
    "bias": "none",
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ],
    "language_path": "model.language_model",
    "seed": 42,
    "gradient_checkpointing": true,
    "use_rslora": false,
    "cpu_activation_offload": false,
    "offload_min_tokens": 65536
  },
  "registered_development": "/storage/self-curate-rebench/environments/development-records.json",
  "registered_benchmarks": "/storage/self-curate-rebench/environments/benchmark-records.json",
  "sampling": null,
  "protocol": null,
  "server_template": "configs/experiments/exp001/server.template.json",
  "gpu_uuids": [],
  "terminal_tasks": "/storage/self-curate-rebench/terminal/tasks",
  "server_bindings": {
    "model_store": {
      "base_path": "/storage/self-curate-rebench/sources/model/files",
      "initial_adapter": "/storage/self-curate-rebench/preparation/models/initial-adapter",
      "base_fingerprint": null,
      "loader": "AutoModelForImageTextToText"
    },
    "task_execution": null,
    "objective": null,
    "edit_policy": null,
    "agent_sampling": null,
    "capacity_receipt": null,
    "runtime_lock": null,
    "services": null
  },
  "installed_environments": "/storage/self-curate-rebench/environments/installed",
  "runtime_lock": null,
  "container_gateway": null,
  "base_port": 8100
}
